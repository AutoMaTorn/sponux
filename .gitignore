# Bytecode
__pycache__/
*.pyc
*.pyo

# Build output. dist/ holds the release artifacts, build/ is mkdeb.py's
# staging tree — both are regenerated by tools/mk*.py and neither belongs
# in the repository.
dist/
build/

# Release artifacts, in case one is built outside dist/
*.deb
*.tar.gz
*.whl

# Packaging metadata setuptools leaves behind
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/

# Test and linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Patch and merge leftovers
*.orig
*.rej

# Working notes for whoever is developing this, not part of a release: they
# carry absolute paths from a specific machine and a session-by-session log.
HANDOFF.md

# Checklist and paste-ready text for publishing on GitHub. It describes the
# repository from the outside — release notes, the About blurb, the first commit
# message — so it does not belong inside it.
PUBLISHING.md

# Screenshots from tools/visual.py, if pointed at the repository root. Scoped to
# the root on purpose: an unanchored pattern would also swallow anything named
# shot-*.png under docs/images/, which is where the README's assets live.
/shot-*.png
